POSTGRES_DB=qasedak
POSTGRES_USER=qasedak
POSTGRES_PASSWORD=change-me-for-local-only
POSTGRES_PORT=5432
API_PORT=8080
WEB_PORT=3000
QASEDAK_API_INTERNAL_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Billing / payments (ADR-008). Secrets stay server-side only; never commit real
# values. The API reads configuration via the standard ASP.NET environment
# mapping, e.g. Billing__Payments__Zarinpal__MerchantId.
# ---------------------------------------------------------------------------
# Absolute public base of the API (builds provider callback URLs; no secrets in them).
BILLING_CALLBACK_BASE_URL=
# Absolute base of the Next.js frontend (callback redirects land on its result page).
BILLING_FRONTEND_BASE_URL=

# Zarinpal — CURRENT official gateway REST contract (docs.zarinpal.com).
ZARINPAL_ENABLED=false
# 36-character merchant code issued by Zarinpal (SECRET).
ZARINPAL_MERCHANT_ID=
# Official payment API base; swap to the sandbox host only for local experiments.
ZARINPAL_BASE_URL=https://payment.zarinpal.com
# Canonical Qasedak currency: IRR (Rial). Do not mix with IRT/Toman.
ZARINPAL_CURRENCY=IRR

# Behpardakht Mellat gateway — implemented against the vendor reference
# docs/vendor/behpardakht/BEHPARDAKHT-IPG-v1.29-EN.md (IPG User Guide v1.29, Tir 1402,
# "Unofficial - External" translation). Enable ONLY with real merchant credentials issued
# for a terminal whose registered IP/domain covers this deployment (see docs/08 §6).
MELLAT_ENABLED=false
MELLAT_TERMINAL_ID=
# Merchant portal credentials (SECRET — never commit real values).
MELLAT_USERNAME=
MELLAT_PASSWORD=
# SOAP service endpoint (vendor §6.1; "?wsdl" identifies the WSDL document).
MELLAT_SERVICE_URL=https://bpm.shaparak.ir/pgwchannel/services/pgw?wsdl
# Persian payment page the browser is POSTed to with the RefId (vendor §8.2).
MELLAT_PAYMENT_PAGE_URL=https://bpm.shaparak.ir/pgwchannel/startpay.mellat
# SOAP target namespace; override only if Shaparak publishes a different binding.
MELLAT_SERVICE_NAMESPACE=http://interfaces.core.bpm.bpt.com/
# Absolute public callback base on the REGISTERED merchant domain (vendor §5/§9).
MELLAT_CALLBACK_BASE_URL=
