# .NET
**/bin/
**/obj/
*.user
*.suo
TestResults/
coverage/

# Node
**/node_modules/
**/.next/
**/out/
**/.turbo/
*.tsbuildinfo

# Environment / secrets
# .env.* would also ignore deploy/.env.production.example (a tracked example template,
# not the real production file). Re-allow only that example; never real .env.production.
.env
.env.*
!.env.example
!deploy/.env.production.example
*.pfx
*.pem
*.key

# IDE / OS
.vs/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Graphify runtime artifacts
# graph.json and GRAPH_REPORT.md are intentionally versioned after M00-003.
graphify-out/graph.html
graphify-out/.cache/
graphify-out/cache/

# Python
__pycache__/
*.py[cod]

# Agent locks/runs are runtime state; keep placeholders only.
.agent-state/locks/*
!.agent-state/locks/.gitkeep
.agent-state/runs/*
!.agent-state/runs/.gitkeep

# Local artifacts
*.zip
