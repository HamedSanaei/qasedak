# Qasedak production environment template.
# Copy to /opt/qasedak/.env.production, chmod 600, and replace every CHANGE_ME value.
# Never commit the real file or its secret files.

IMAGE_NAMESPACE=your-lowercase-ghcr-owner
IMAGE_TAG=sha-000000000000

POSTGRES_DB=qasedak
POSTGRES_USER=qasedak
# This is a path to a Docker secret file, not the password itself.
POSTGRES_PASSWORD_FILE=./secrets/postgres_password.txt
# All seven EF contexts use this ONE physical database. Each owns a logical schema.
QASEDAK_DB_CONNECTION_STRING="Host=postgres;Port=5432;Database=qasedak;Username=qasedak;Password=CHANGE_ME_DATABASE_PASSWORD"

# Bind API/Web to loopback when a reverse proxy is present; change only when required.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
PUBLIC_WEB_ORIGIN=https://app.example.invalid

# Required application secrets; use a secret manager or chmod 600 server-side file.
IDENTITY_AUTH_TOKEN_SIGNING_KEY=CHANGE_ME_at_least_32_random_bytes
IDENTITY_AUTH_TOKEN_LIFETIME_HOURS=12
INSTAGRAM_META_APP_SECRET=CHANGE_ME
INSTAGRAM_META_VERIFY_TOKEN=CHANGE_ME
INSTAGRAM_PROTECTION_KEY_BASE64=CHANGE_ME_exactly_32_bytes_base64

# Public callback/frontend bases for billing; no credentials belong in URLs.
BILLING_CALLBACK_BASE_URL=https://api.example.invalid
BILLING_FRONTEND_BASE_URL=https://app.example.invalid

# Zarinpal (disabled by default; credentials remain server-side only).
ZARINPAL_ENABLED=false
ZARINPAL_MERCHANT_ID=
ZARINPAL_BASE_URL=https://payment.zarinpal.com
ZARINPAL_CURRENCY=IRR

# Behpardakht Mellat (disabled by default; enable only after merchant onboarding).
MELLAT_ENABLED=false
MELLAT_TERMINAL_ID=
MELLAT_USERNAME=
MELLAT_PASSWORD=
MELLAT_SERVICE_URL=https://bpm.shaparak.ir/pgwchannel/services/pgw?wsdl
MELLAT_PAYMENT_PAGE_URL=https://bpm.shaparak.ir/pgwchannel/startpay.mellat
MELLAT_SERVICE_NAMESPACE=http://interfaces.core.bpm.bpt.com/
